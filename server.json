{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.alfongj-com/yo",
  "version": "1.0.1",
  "description": "Let agents send content-free push notifications to a paired phone via MCP.",
  "title": "Yo",
  "websiteUrl": "https://getyo.dev",
  "repository": {
    "url": "https://github.com/alfongj-com/yo-plugin",
    "source": "github"
  },
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://getyo.dev/mcp",
      "headers": [
        {
          "name": "Authorization",
          "value": "Bearer {YO_API_KEY}",
          "variables": {
            "YO_API_KEY": {
              "description": "Create or manage your Yo API key at https://getyo.dev/agents",
              "isRequired": true,
              "isSecret": true
            }
          }
        }
      ]
    }
  ]
}
